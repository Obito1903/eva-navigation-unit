import { Theme } from "../theme.slint";

// Text that slides back and forth when it is wider than its box, so long
// entries (e.g. a device name plus its MAC) stay fully readable. Sits still
// when the text already fits.
component MarqueeText inherits Rectangle {
    in property <string> text;
    in property <brush> text-color;

    clip: true;
    // Without this the natural text width becomes the box's min-width, which
    // would widen the dropdown instead of scrolling inside it.
    min-width: 0px;

    private property <length> overflow: max(0px, label.preferred-width - self.width);
    private property <bool> shifted: false;

    label := Text {
        text: root.text;
        color: root.text-color;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 1px;
        vertical-alignment: center;
        width: self.preferred-width;
        height: 100%;
        x: root.shifted ? -root.overflow : 0px;
        animate x { duration: 1800ms; easing: ease-in-out; }
    }

    Timer {
        interval: 2500ms;
        running: root.overflow > 0px;
        triggered => {
            root.shifted = !root.shifted;
        }
    }
}

// NERV-styled dropdown selector. Shows the current option and opens a popup
// list of choices. Emits `selected(index)` when a new option is picked.
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current-index: 0;
    callback selected(int);

    height: 36px;
    min-width: 160px;
    background: Theme.panel-btn;
    border-width: 1px;
    border-color: Theme.red-dim;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        MarqueeText {
            text: (root.current-index >= 0 && root.current-index < root.options.length)
                ? root.options[root.current-index] : "";
            text-color: Theme.text;
            horizontal-stretch: 1;
        }

        Text {
            text: "▾";
            color: Theme.text-dim;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            popup.show();
        }
    }

    popup := PopupWindow {
        x: 0;
        y: parent.height + 2px;
        width: root.width;

        Rectangle {
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.red-dim;

            VerticalLayout {
                for opt[idx] in root.options : Rectangle {
                    height: 34px;
                    background: idx == root.current-index ? Theme.red-dim : transparent;

                    MarqueeText {
                        x: 12px;
                        width: parent.width - 24px;
                        height: 100%;
                        text: opt;
                        text-color: idx == root.current-index ? Theme.text : Theme.text-dim;
                    }

                    TouchArea {
                        clicked => {
                            root.current-index = idx;
                            root.selected(idx);
                        }
                    }
                }
            }
        }
    }
}
